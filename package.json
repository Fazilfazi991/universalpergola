{
  "name": "universal-pergola-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test \"test/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "db:start": "npx --yes supabase@2.117.0 start",
    "db:stop": "npx --yes supabase@2.117.0 stop",
    "db:reset": "npx --yes supabase@2.117.0 db reset",
    "db:types": "npx --yes supabase@2.117.0 gen types typescript --local > src/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "caniuse-lite": "1.0.30001810",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
